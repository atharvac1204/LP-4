# 1. Import libraries
import pandas as pd
import numpy as np
import re
from gensim.models import Word2Vec
from sklearn.metrics.pairwise import cosine_similarity

# 2. Load dataset
df = pd.read_csv("twitter_dataset.csv")
df = df.dropna(subset=["Text"])

# 3. Clean tweets
tweets = []

for tweet in df["Text"]:
    tweet = tweet.lower()
    tweet = re.sub(r"[^a-z\s]", "", tweet)
    tweets.append(tweet.split())

# 4. Train CBOW model
cbow = Word2Vec(
    sentences=tweets,
    vector_size=100,
    window=5,
    min_count=2,
    sg=0,
    epochs=10
)

# 5. Convert tweets into vectors
tweet_vectors = []

for tweet in tweets:
    words = [cbow.wv[word] for word in tweet if word in cbow.wv]

    if len(words) > 0:
        tweet_vectors.append(np.mean(words, axis=0))
    else:
        tweet_vectors.append(np.zeros(100))

tweet_vectors = np.array(tweet_vectors)

# 6. Enter a tweet number
tweet_no = 0

# 7. Calculate similarity
similarity = cosine_similarity(
    [tweet_vectors[tweet_no]],
    tweet_vectors
)[0]

# 8. Get top 5 similar tweets
similar_indices = np.argsort(similarity)[::-1][1:6]

# 9. Display recommendations
print("Original Tweet:")
print(df["Text"].iloc[tweet_no])

print("\nRecommended Tweets:")

for index in similar_indices:
    print(df["Text"].iloc[index])
    print("Similarity:", similarity[index])
