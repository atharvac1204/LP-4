# 1. Import libraries
import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import classification_report

from tensorflow.keras import models, layers


# 2. Load dataset
data = pd.read_csv("creditcard.csv")

x = data.drop("Class", axis=1)
y = data["Class"]

x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.2, random_state=42, stratify=y
)

# Keep only normal transactions
normal = x_train[y_train == 0]

# Scale data
scaler = StandardScaler()
normal = scaler.fit_transform(normal)
x_test = scaler.transform(x_test)

x_train, x_val = train_test_split(
    normal, test_size=0.1, random_state=42
)


# 3. Create Autoencoder
encoder = models.Sequential([
    layers.Input(shape=(x_train.shape[1],)),
    layers.Dense(20, activation="relu"),
    layers.Dense(14, activation="relu"),
    layers.Dense(8, activation="relu"),
    layers.Dense(4, activation="relu")
])

decoder = models.Sequential([
    layers.Input(shape=(4,)),
    layers.Dense(8, activation="relu"),
    layers.Dense(14, activation="relu"),
    layers.Dense(20, activation="relu"),
    layers.Dense(x_train.shape[1], activation="linear")
])

model = models.Sequential([encoder, decoder])

model.compile(
    optimizer="adam",
    loss="mse",
    metrics=["mae"]
)


# 4. Train model
model.fit(
    x_train, x_train,
    validation_data=(x_val, x_val),
    epochs=20,
    batch_size=512,
    shuffle=True
)


# 5. Detect anomalies
threshold = np.percentile(
    np.mean((x_val - model.predict(x_val, verbose=0)) ** 2, axis=1),
    99
)

error = np.mean(
    (x_test - model.predict(x_test, verbose=0)) ** 2,
    axis=1
)

prediction = (error > threshold).astype(int)

print("Threshold:", threshold)

print(classification_report(
    y_test, prediction,
    target_names=["Normal", "Fraud"],
    zero_division=0
))

print("Anomalies detected:", prediction.sum())



