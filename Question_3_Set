# 1. Import libraries
import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report

from tensorflow.keras import models, layers


# 2. Load dataset
data = pd.read_csv("sign_mnist_train.csv")

x = data.drop("label", axis=1).values
y = data["label"].values

# Normalize data
x = x / 255.0

# Reshape images
x = x.reshape(-1, 28, 28, 1)

# Keep normal classes (exclude label 24)
normal = x[y != 24]
anomaly = x[y == 24]

# Split normal data
x_train, x_val = train_test_split(
    normal, test_size=0.1, random_state=42
)

# Create test data
x_test = np.concatenate([x_val, anomaly])

y_test = np.concatenate([
    np.zeros(len(x_val)),
    np.ones(len(anomaly))
])


# 3. Create Autoencoder
encoder = models.Sequential([
    layers.Input(shape=(28, 28, 1)),
    layers.Flatten(),
    layers.Dense(128, activation="relu"),
    layers.Dense(64, activation="relu"),
    layers.Dense(32, activation="relu")
])

decoder = models.Sequential([
    layers.Input(shape=(32,)),
    layers.Dense(64, activation="relu"),
    layers.Dense(128, activation="relu"),
    layers.Dense(784, activation="sigmoid"),
    layers.Reshape((28, 28, 1))
])

model = models.Sequential([encoder, decoder])

model.compile(
    optimizer="adam",
    loss="mse",
    metrics=["mae"]
)


# 4. Train model
model.fit(
    x_train, x_train,
    validation_data=(x_val, x_val),
    epochs=20,
    batch_size=128
)


# 5. Detect anomalies
threshold = np.percentile(
    np.mean((x_val - model.predict(x_val, verbose=0)) ** 2,
            axis=(1, 2, 3)),
    99
)

error = np.mean(
    (x_test - model.predict(x_test, verbose=0)) ** 2,
    axis=(1, 2, 3)
)

prediction = (error > threshold).astype(int)

print("Threshold:", threshold)

print(classification_report(
    y_test, prediction,
    target_names=["Normal", "Anomaly"],
    zero_division=0
))

print("Anomalies detected:", prediction.sum())


